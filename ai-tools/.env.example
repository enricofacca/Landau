# Provider commands only. Authentication contexts are selected by
# ai-tools/config/accounts.toml + ai-tools/scripts/backend_runner.py.
#
# The account email examples in ai-tools/config/accounts.toml are fake @example.com
# labels. Replace them there; never put passwords/tokens in this file.
#
# Exact batch flags can evolve with provider CLI versions. Verify them locally
# before enabling unattended work.

# Codex: backend_runner injects CODEX_HOME for the selected account profile.
CODEX_BATCH_CMD='codex exec --full-auto "$(cat)"'
CODEX_INTERACTIVE_CMD='codex'

# Claude Code: backend_runner injects CLAUDE_CONFIG_DIR for the selected profile.
# `-p` is Claude Code non-interactive/print mode; adapt permission flags locally.
CLAUDE_BATCH_CMD='claude -p "$(cat)"'
CLAUDE_INTERACTIVE_CMD='claude'

# Antigravity: auth is keyring-based. Point the command through the isolated
# launcher injected as WORKBENCH_ACCOUNT_LAUNCHER. `-p` is headless print mode.
ANTIGRAVITY_BATCH_CMD='"$WORKBENCH_ACCOUNT_LAUNCHER" -p "$(cat)"'
ANTIGRAVITY_INTERACTIVE_CMD='"$WORKBENCH_ACCOUNT_LAUNCHER"'

CUSTOM_BATCH_CMD='replace-with-custom-coder-batch-command'
CUSTOM_INTERACTIVE_CMD='replace-with-custom-interactive-command'

ADVISOR_CMD='replace-with-advisor-batch-command'
